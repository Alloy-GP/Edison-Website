---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { ServicePage } from '../../../templates/service-page-template.jsx';
import { SERVICES_CONTENT } from '../../../content/services-content.jsx';
import { SITE } from '../../../config/site.ts';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../../lib/schema.ts';
const content = SERVICES_CONTENT['hoa-collections'];

const url = `${SITE.url}/services/hoa-collections`;
const description = "In-house HOA collections in Orlando, FL. Edison handles delinquency, lien workflow, and homeowner outreach through the intent-to-lien stage.";

// Sitemap v3.2 spec for a service page: Service + FAQPage.
const pageSchema = [
  serviceSchema({ name: 'HOA Collections & Delinquency Management', serviceType: 'HOA Collections', description, url }),
  breadcrumbSchema([
    { name: 'Home',     url: `${SITE.url}/` },
    { name: 'Services', url: `${SITE.url}/services` },
    { name: 'HOA Collections',  url },
  ]),
  faqSchema(content.faqs),
];
---

<SiteLayout
  title="HOA Collections & Delinquency Services | Edison"
  description={description}
  pageSchema={pageSchema}
>
  <ServicePage content={content} client:load />
</SiteLayout>
