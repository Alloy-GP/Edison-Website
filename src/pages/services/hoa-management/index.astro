---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { PillarPageA } from '../../../templates/service-template.jsx';
import { PILLAR_CONTENT } from '../../../content/pillars-content.jsx';
import { SITE } from '../../../config/site.ts';
import { aggregateRatingSchema, breadcrumbSchema, faqSchema, serviceSchema } from '../../../lib/schema.ts';
const content = PILLAR_CONTENT['hoa-management'];

const url = `${SITE.url}/services/hoa-management`;
const description = "PCAM-led Florida HOA management company for single-family and townhome communities across Central Florida. Limited manager portfolios, dedicated back-office.";

// Sitemap v3.2 spec for a main pillar:
// Service + Organization + AggregateRating + FAQPage.
const pageSchema = [
  serviceSchema({
    name: 'HOA Management',
    serviceType: 'HOA Management',
    description,
    url,
  }),
  aggregateRatingSchema(),
  breadcrumbSchema([
    { name: 'Home',     url: `${SITE.url}/` },
    { name: 'Services', url: `${SITE.url}/services` },
    { name: 'HOA Management',  url },
  ]),
  faqSchema(content.faqs),
];
---

<SiteLayout
  title="Florida HOA Management Company | Edison Association Management"
  description={description}
  pageSchema={pageSchema}
>
  <PillarPageA content={content} client:load />
</SiteLayout>
