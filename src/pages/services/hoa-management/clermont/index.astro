---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { GeoPageB } from '../../../../templates/geo-template.jsx';
import { GEO_CONTENT } from '../../../../content/geo-content.jsx';
import { SITE } from '../../../../config/site.ts';
import { breadcrumbSchema, faqSchema, geoPageSchema } from '../../../../lib/schema.ts';
const content = GEO_CONTENT['clermont'];

const url = `${SITE.url}/services/hoa-management/clermont`;
const description = "HOA management in Clermont, FL. Edison serves Lake County communities with boutique, responsive association management.";

// Sitemap v3.2 spec for a geo page: LocalBusiness (with serviceArea) + Service.
const pageSchema = [
  ...geoPageSchema({ city: content.city, region: content.region, url, description }),
  breadcrumbSchema([
    { name: 'Home',           url: `${SITE.url}/` },
    { name: 'Services',       url: `${SITE.url}/services` },
    { name: 'HOA Management', url: `${SITE.url}/services/hoa-management` },
    { name: content.city,     url },
  ]),
  faqSchema(content.faqs),
];
---

<SiteLayout
  title="HOA Management in Clermont, FL | Edison"
  description={description}
  pageSchema={pageSchema}
>
  <GeoPageB content={content} client:load />
</SiteLayout>
