---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { SubServicePage } from '../../../../templates/sub-service-template.jsx';
import { SUB_SERVICES_CONTENT } from '../../../../content/sub-services-content.jsx';
import { SITE } from '../../../../config/site.ts';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../../../lib/schema.ts';
const content = SUB_SERVICES_CONTENT['townhome'];

const url = `${SITE.url}/services/hoa-management/townhome`;
const description = "Townhome association management in Central Florida — building envelope coordination, master-policy tracking, party-wall protocols, and Ch. 720 compliance.";

// Sitemap v3.2 spec for a sub-service: Service + FAQPage. FAQ answers are
// lifted verbatim from the on-page accordion.
const pageSchema = [
  serviceSchema({ name: 'Townhome Association Management', serviceType: 'HOA Management', description, url }),
  breadcrumbSchema([
    { name: 'Home',      url: `${SITE.url}/` },
    { name: 'Services',  url: `${SITE.url}/services` },
    { name: 'HOA Management',  url: `${SITE.url}/services/hoa-management` },
    { name: 'Townhome',   url },
  ]),
  faqSchema(content.faqs),
];
---

<SiteLayout
  title="Townhome Association Management | Edison Association Management"
  description={description}
  pageSchema={pageSchema}
>
  <SubServicePage content={content} client:load />
</SiteLayout>
