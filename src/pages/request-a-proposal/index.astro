---
// Multi-intent intake form (ported from the AGP Astro starter).
// Form options/copy: src/components/intake-form.config.js
// Email routing/replies: src/lib/email.config.ts  ·  Posts to /api/lead
import SiteLayout from '../../layouts/SiteLayout.astro';
import IntakeForm from '../../components/IntakeForm.jsx';
import '../../styles/intake-form.css';
---

<SiteLayout
  title="Request an HOA Management Proposal | Edison"
  description="Request a customized HOA management proposal from Edison Association Management. Serving communities across Central Florida."
>
  <section class="rap-page">
    <div class="rap-inner">
      <header class="rap-head">
        <p class="rap-eyebrow">Get in touch</p>
        <h1>Request a Proposal</h1>
        <p class="rap-sub">Tell us about your community and we'll prepare a tailored management proposal — or pick another option below if you need something else. A real person follows up within one business day.</p>
      </header>
      <IntakeForm client:load />
    </div>
  </section>
</SiteLayout>

<style>
  .rap-page { padding: clamp(56px, 8vw, 104px) 20px; background: var(--edison-teal-pale); }
  .rap-inner { max-width: 640px; margin: 0 auto; }
  .rap-head { text-align: center; margin-bottom: 30px; }
  .rap-eyebrow { font-family: var(--font-display); font-weight: 700; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--edison-teal-dark); margin: 0 0 12px; }
  .rap-head h1 { font-family: var(--font-display); font-weight: 800; font-size: clamp(30px, 5vw, 44px); line-height: 1.08; letter-spacing: -0.02em; color: var(--edison-navy); margin: 0 0 14px; }
  .rap-sub { font-family: var(--font-body); font-size: 16.5px; line-height: 1.6; color: var(--edison-text-body); margin: 0 auto; max-width: 540px; }
  .rap-inner :global(.if-widget) { margin-inline: auto; }
</style>
