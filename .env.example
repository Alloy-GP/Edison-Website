# Copy this file to .env and fill in real values. Never commit .env to git.

# ── Resend ──────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Mailchimp (delete these 3 lines if not using Mailchimp) ─────
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
MAILCHIMP_SERVER_PREFIX=us21
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxxxx

# ── Newsletter landing (/newsletter) ────────────────────────────
# Id of the Mailchimp campaign folder named "Edison Newsletter". The current
# issue + archive are built from the sent campaigns in this folder. Find it in
# the campaigns API response, or GET /campaign-folders. Until it's set, the page
# falls back to the seed in src/data/newsletter/current.json.
MAILCHIMP_NEWSLETTER_FOLDER_ID=
# Vercel Deploy Hook URL — Project → Settings → Git → Deploy Hooks. Fired by
# /api/newsletter-webhook so the archive rebuilds automatically on each send.
VERCEL_DEPLOY_HOOK_URL=
# Optional shared secret guarding the webhook. If set, append ?secret=... to the
# webhook URL configured in Mailchimp.
MAILCHIMP_WEBHOOK_SECRET=

# ── Internal notifications ──────────────────────────────────────
INTERNAL_NOTIFY_EMAIL=owner@clientsite.com

# ── Google Analytics (leave blank to skip GA entirely) ──────────
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google Places (live reviews on /api/reviews — uses Places API New) ──
GOOGLE_PLACES_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_PLACE_ID=ChIJxxxxxxxxxxxxxxxxxxxxxxxx

# ── Slack webhook for failed-form-submission alerts (optional) ──
# If unset, failure alerts fall back to email (EMAIL_CONFIG.alertsTo).
FORM_ALERT_SLACK_URL=https://hooks.slack.com/services/XXX/XXX/XXX
